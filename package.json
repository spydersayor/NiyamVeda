{
  "name": "niyamveda-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Explainable BIS Compliance Intelligence Assistant for Indian MSMEs (SIH26107)",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan.bold,yellow.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd frontend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "test:backend": "cd backend && python -m pytest tests/test_core.py -v"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
