# NiyamVeda Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Configuration (comma-separated origins allowed to access the API)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Connection URL (e.g. Render Internal/External Database URL)
DATABASE_URL=postgresql://niyamveda:niyamveda@localhost:5432/niyamveda_db

# Gemini AI Credentials & Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Storage Limits
MAX_UPLOAD_SIZE_MB=10
