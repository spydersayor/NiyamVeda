# NIYAMVEDA (नियमवेद) - Environment Configuration
# From Product to Compliance Clarity (SIH26107)

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL with pgvector)
# For local dev without Docker, backend automatically falls back to embedded SQLite + cosine similarity
DATABASE_URL=postgresql://niyamveda:niyamveda@localhost:5432/niyamveda_db

# AI & Embedding Providers
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Strict Embedding Dimensionality Configuration
# Explicitly 768 to match pgvector column vector(768) and text-embedding-004 output dimension
EMBEDDING_DIMENSION=768

# Upload & Storage Config
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
